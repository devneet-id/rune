#!/usr/bin/env php
<?php
/*
 * RUNE DEV — THE WORKSHOP
 * The main runite of the dev branch of devneet-id/rune.
 * Runes: Aether, Whisper, Weaver, Chanter, Forger, Cipher, Keeper, Specter.
 *
 * Rune itself lives in core/ (git-ignored): a clone of this repo on 1.x, or on an agent's branch.
 *
 *   php cast init                         clone Rune into core/ (on 1.x) and write the autoloader
 *   php cast init --branch=<branch>       the same, on another branch (e.g. an agent's)
 *   php cast use --branch=<branch>        switch core/ to a branch (an agent's) — no branch: back to 1.x
 *   php cast update                       pull this dev branch and core/, then write the autoloader again
 *
 *   php cast scenario                     every scenario, one by one, each in a new terminal (Specter)
 *   php cast scenario --here              every scenario in this terminal (no window: headless, agents)
 *   php cast scenario --only=keep-notes   one scenario
 *   php cast scenario --timeout=180       seconds to wait for one scenario (default 120)
 *
 * Each scenario writes its proof in scenario/<name>/.proof/ (git-ignored):
 * report.txt, report.json and what it made. This cast reads report.json.
 */
// init runs before Rune exists: it brings Rune into core/, so it is plain PHP
function workshop_shell( String $line ) {
  echo "  > $line\n";
  passthru($line, $code);
  return $code === 0;
}

function workshop_option( Array $argv, String $key, String $default ) {
  foreach ($argv as $arg) {
    if (str_starts_with($arg, "--$key=")) {
      return substr($arg, strlen($key) + 3);
    }
  }
  return $default;
}

function workshop_init( Array $argv ) {
  $core = __DIR__ . DIRECTORY_SEPARATOR . 'core';
  $branch = workshop_option($argv, 'branch', '1.x');
  echo "\nI N I T  Rune into core/ on $branch\n\n";
  if (is_dir($core . DIRECTORY_SEPARATOR . '.git')) {
    echo "core/ is already there. Switch it with: php cast use --branch=<branch>\n";
  } else {
    $repo = workshop_option($argv, 'repo', trim((string) shell_exec('git -C ' . escapeshellarg(__DIR__) . ' remote get-url origin')));
    if ($repo === '') {
      echo "No git remote 'origin' here: give the repo with --repo=<url>\n";
      return 1;
    }
    if (!workshop_shell('git clone --branch ' . escapeshellarg($branch) . ' ' . escapeshellarg($repo) . ' ' . escapeshellarg($core))) {
      return 1;
    }
  }
  if (!workshop_shell('composer dump-autoload --working-dir=' . escapeshellarg(__DIR__))) {
    echo "Composer is needed: install it, then run composer dump-autoload here.\n";
    return 1;
  }
  echo "\nReady. Run every scenario with: php cast scenario --here\n";
  return 0;
}

if (($argv[1] ?? '') === 'init') {
  exit(workshop_init($argv));
}
if (!is_file(__DIR__ . '/core/Aether/Manifest.php') || !is_file(__DIR__ . '/vendor/autoload.php')) {
  echo "Rune is not in core/ yet. Run: php cast init\n";
  exit(1);
}
require_once __DIR__ . '/vendor/autoload.php';


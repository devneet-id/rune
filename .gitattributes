# The rune repo stores LF on every OS (a CRLF shebang breaks a runite on Linux and macOS).
# On Windows, git may still show CRLF in the working copy (core.autocrlf); it commits LF.
* text=auto eol=lf

# binaries are never converted
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.rune binary

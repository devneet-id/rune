#!/usr/bin/env php
<?php
/*
 * SCENARIO — SURVIVE GLITCHES AND EXIT
 * How a runite with Keeper awake meets a PHP warning, and what it tells the shell when it ends.
 * Each case is a small probe runite written in .proof/ and cast in its own process,
 * so a glitch ends the probe, not this trial.
 * Runes: Aether, Whisper, Weaver, Chanter, Forger, Cipher, Keeper.
 *
 *   php cast test
 */
require_once __DIR__ . '/../../vendor/autoload.php';
require_once __DIR__ . '/../trial.php';

use Rune\Aether\Manifest as Aether;
use Rune\Whisper\Manifest as Whisper;
use Rune\Weaver\Manifest as Weaver;
use Rune\Chanter\Manifest as Chanter;
use Rune\Forger\Manifest as Forger;
use Rune\Cipher\Manifest as Cipher;
use Rune\Keeper\Manifest as Keeper;
#sentinel-manifest
Aether::ether()::essence()::entity();
Whisper::ether()::essence()::entity();
Weaver::ether()::essence()::entity();
Chanter::ether()::essence()::entity();
Forger::ether()::essence()::entity();
Cipher::ether()::essence()::entity();
Keeper::ether()::essence()::entity();
#sentinel-awaken

Aether::begin();
Chanter::begin();
Keeper::begin();


// a probe runite with Keeper awake; $body is the code of its cast `run`
function survive_probe( String $name, String $body ) {
  $probe = trial_proof("$name/cast");
  if (!is_dir(dirname($probe))) {
    mkdir(dirname($probe), 0777, true);
  }
  $autoload = var_export(dirname(__DIR__, 2) . '/vendor/autoload.php', true);
  file_put_contents($probe, <<<PHP
<?php
require_once $autoload;
use Rune\Aether\Manifest as Aether;
use Rune\Whisper\Manifest as Whisper;
use Rune\Weaver\Manifest as Weaver;
use Rune\Chanter\Manifest as Chanter;
use Rune\Forger\Manifest as Forger;
use Rune\Cipher\Manifest as Cipher;
use Rune\Keeper\Manifest as Keeper;
Aether::ether()::essence()::entity();
Whisper::ether()::essence()::entity();
Weaver::ether()::essence()::entity();
Chanter::ether()::essence()::entity();
Forger::ether()::essence()::entity();
Cipher::ether()::essence()::entity();
Keeper::ether()::essence()::entity();
Aether::begin();
Chanter::begin();
Keeper::begin();
Chanter::cast('run', function() {
$body
});
Chanter::end();
Keeper::end();
Aether::end();

PHP);
  return $probe;
}

// casts a probe in its own process: [plain output, exit code]
function survive_cast( String $probe, String $cast = 'run' ) {
  $output = [];
  $code = null;
  exec(escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg($probe) . ' ' . $cast . ' 2>&1', $output, $code);
  return [trial_plain(implode("\n", $output)), $code];
}

Chanter::cast('test', function() {
  trial_proof_clean('normal');
  trial_proof_clean('silenced');
  trial_proof_clean('loud');
  foreach (['tolerated', 'notice', 'thrown', 'uncaught'] as $probe) {
    trial_proof_clean($probe);
  }

  trial_section('A runite that ends well');
  [$out, $code] = survive_cast(survive_probe('normal', '  print("ALL GOOD\n");'));
  trial('it runs its cast', str_contains($out, 'ALL GOOD'));
  trial('it exits with code 0', $code === 0);

  trial_section('A warning silenced with @ (devneet-id/rune#16)');
  // mkdir on a folder that exists warns; @ asks PHP to stay quiet, so Keeper must not glitch
  [$out, $code] = survive_cast(survive_probe('silenced', '  @mkdir(__DIR__);' . "\n" . '  print("SURVIVED\n");'));
  trial('@mkdir on an existing folder does not end the flow', str_contains($out, 'SURVIVED'));
  trial('no glitch is written for it', trim((string) @file_get_contents(trial_proof('silenced/.echoes/cast/glitch.txt'))) === '');

  trial_section('A warning not silenced');
  [$out, $code] = survive_cast(survive_probe('loud', '  mkdir(__DIR__);' . "\n" . '  print("SURVIVED\n");'));
  trial('mkdir on an existing folder is a glitch and ends the flow', !str_contains($out, 'SURVIVED') && str_contains((string) @file_get_contents(trial_proof('loud/.echoes/cast/glitch.txt')), 'mkdir'));
  // a glitch must tell the shell it failed (devneet-id/rune#19)
  trial('a glitch exits with a code other than 0', $code !== 0);

  trial_section('Keeper::tolerate() (devneet-id/rune#24)');
  [$out, $code] = survive_cast(survive_probe('tolerated', '  Keeper::tolerate([\'warning\']);' . "\n" . '  mkdir(__DIR__);' . "\n" . '  print("SURVIVED\n");'));
  trial('a tolerated warning does not end the flow', str_contains($out, 'SURVIVED') && $code === 0);
  trial('it is not a glitch (glitch.txt stays empty)', trim((string) @file_get_contents(trial_proof('tolerated/.echoes/cast/glitch.txt'))) === '');
  trial('it is kept in the arcane', str_contains((string) @file_get_contents(trial_proof('tolerated/.echoes/cast/arcane.txt')), 'Keeper.glitch.tolerated'));
  [$out, $code] = survive_cast(survive_probe('notice', '  Keeper::tolerate([\'warning\']);' . "\n" . '  trigger_error("a notice", E_USER_NOTICE);' . "\n" . '  print("SURVIVED\n");'));
  trial('a level not tolerated is still a glitch', !str_contains($out, 'SURVIVED') && $code !== 0);

  trial_section('Keeper::tolerate(\'throw\')');
  [$out, $code] = survive_cast(survive_probe('thrown', '  Keeper::tolerate(\'throw\');' . "\n" . '  try { mkdir(__DIR__); } catch (\\ErrorException $glitch) { print("CAUGHT\n"); }' . "\n" . '  print("SURVIVED\n");'));
  trial('a warning becomes an ErrorException the cast can catch', str_contains($out, 'CAUGHT') && str_contains($out, 'SURVIVED') && $code === 0);
  [$out, $code] = survive_cast(survive_probe('uncaught', '  Keeper::tolerate(\'throw\');' . "\n" . '  mkdir(__DIR__);' . "\n" . '  print("SURVIVED\n");'));
  trial('uncaught, it is a glitch and exits non-zero', !str_contains($out, 'SURVIVED') && $code !== 0);

  trial_report();
}, 'Trial of this scenario.');


#sentinel-codex
Chanter::end();
Keeper::end();
Aether::end();

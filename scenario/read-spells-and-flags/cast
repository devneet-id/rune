#!/usr/bin/env php
<?php
/*
 * SCENARIO — READ SPELLS AND FLAGS
 * How Chanter reads a spell: a bare flag (--loud), a value (--times=1), zero (--times=0),
 * and how a cast hands its spells on to another cast (cast-in-cast).
 * A flag is true; a value is a string — "1" is a value, not a flag.
 * A value is read as given: on the command line a %2F stays %2F; in a cast written in code a space is %20.
 * Runes: Aether, Whisper, Weaver, Chanter.
 *
 *   php cast probe --loud --times=1 --zero=0 --word=a+b
 *   php cast test
 */
require_once __DIR__ . '/../../vendor/autoload.php';
require_once __DIR__ . '/../trial.php';

use Rune\Aether\Manifest as Aether;
use Rune\Whisper\Manifest as Whisper;
use Rune\Weaver\Manifest as Weaver;
use Rune\Chanter\Manifest as Chanter;
#sentinel-manifest
Aether::ether()::essence()::entity();
Whisper::ether()::essence()::entity();
Weaver::ether()::essence()::entity();
Chanter::ether()::essence()::entity();
#sentinel-awaken

Aether::begin();
Chanter::begin();


// what Chanter gives for each spell: [Chanter::spell(), chanter_spell_has()]
function spells_read( Array $names ) {
  $read = [];
  foreach ($names as $name) {
    $read[$name] = [Chanter::spell($name), chanter_spell_has($name)];
  }
  return $read;
}

$GLOBALS['SPELLS_SEEN'] = [];
Chanter::cast('probe --loud --times --zero --word --missing --api --text', function() {
  $GLOBALS['SPELLS_SEEN'] = spells_read(['loud', 'times', 'zero', 'word', 'missing', 'api', 'text']);
  print('SEEN=' . json_encode($GLOBALS['SPELLS_SEEN']) . "\n");
}, 'Show how each spell is read.');

// casts this scenario on the command line, in its own process: what probe saw
function spells_command( String $spells, String $cast = 'probe' ) {
  $out = (string) shell_exec(escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg(__FILE__) . ' ' . $cast . ' ' . $spells . ' 2>&1');
  return preg_match('/SEEN=(\{.*\})/', $out, $m) ? json_decode($m[1], true) : [];
}

// hands its own spells on to probe, the way a cast-in-cast does
Chanter::cast('relay --loud --times --api --text', function() {
  Chanter::cast('probe ' . chanter_spell_chain())();
}, 'Hand the spells on to probe.');


Chanter::cast('test', function() {
  trial_section('A flag and a value (devneet-id/rune#17)');
  trial_cast('probe --loud --times=1 --zero=0 --word=a+b');
  $seen = $GLOBALS['SPELLS_SEEN'];
  trial('a bare flag is true (bool)', ($seen['loud'][0] ?? null) === true);
  trial('--times=1 is the value "1", not a flag', ($seen['times'][0] ?? null) === '1');
  trial('--zero=0 is the value "0"', ($seen['zero'][0] ?? null) === '0');
  trial('a + stays a + (a+b)', ($seen['word'][0] ?? null) === 'a+b');
  trial('a spell not given is false', ($seen['missing'][0] ?? null) === false);

  trial_section('chanter_spell_has: given with a value');
  trial('a bare flag has no value', ($seen['loud'][1] ?? null) === false);
  trial('--times=1 has a value', ($seen['times'][1] ?? null) === true);
  trial('--zero=0 has a value', ($seen['zero'][1] ?? null) === true);

  trial_section('Cast in cast');
  $GLOBALS['SPELLS_SEEN'] = [];
  trial_cast('relay --loud --times=1');
  $seen = $GLOBALS['SPELLS_SEEN'];
  trial('a flag handed on stays a flag', ($seen['loud'][0] ?? null) === true);
  trial('a value handed on stays the value', ($seen['times'][0] ?? null) === '1');

  trial_section('A value is read as given (devneet-id/rune#22)');
  $seen = spells_command('--api=https://x.test/a%2Fb --word=a+b --text=50%25');
  trial('command line: --api=…/a%2Fb stays a%2Fb', ($seen['api'][0] ?? null) === 'https://x.test/a%2Fb');
  trial('command line: --text=50%25 stays 50%25', ($seen['text'][0] ?? null) === '50%25');
  trial('command line: a + stays a +', ($seen['word'][0] ?? null) === 'a+b');
  $seen = spells_command(escapeshellarg('--text=Rune Lore'));
  trial('command line: a quoted space stays a space', ($seen['text'][0] ?? null) === 'Rune Lore');
  $GLOBALS['SPELLS_SEEN'] = [];
  trial_cast('probe --text=Rune%20Lore');
  trial('in code: %20 is a space', ($GLOBALS['SPELLS_SEEN']['text'][0] ?? null) === 'Rune Lore');
  $seen = spells_command('--api=https://x.test/a%2Fb --text=50%25', 'relay');
  trial('cast in cast: the value is handed on unchanged', ($seen['api'][0] ?? null) === 'https://x.test/a%2Fb' && ($seen['text'][0] ?? null) === '50%25');
  Chanter::spell('api', 'https://x.test/a%2Fb');
  $GLOBALS['SPELLS_SEEN'] = [];
  trial_cast('probe');
  trial('a spell set from code is read as given', ($GLOBALS['SPELLS_SEEN']['api'][0] ?? null) === 'https://x.test/a%2Fb');

  trial_report();
}, 'Trial of this scenario.');


#sentinel-codex
Chanter::end();
Aether::end();

#!/usr/bin/env php
<?php
/*
 * SCENARIO — SERVE BEYOND THE RUNITE
 * A runite as a server service (devneet-id/rune#26): Specter starts a worker that outlives the runite
 * (detach, by title), tells whether it is alive and kills it; loops with a pause, a stop and a heartbeat;
 * runs a child command with a timeout, a streamed log and a beat; and keeps souls safe across processes.
 * Runes: Aether, Whisper, Weaver, Chanter, Forger, Cipher, Keeper, Specter.
 *
 *   php cast test
 */
require_once __DIR__ . '/../../vendor/autoload.php';

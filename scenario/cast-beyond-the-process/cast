/*
 * SCENARIO — CAST BEYOND THE PROCESS
 * Specter runs a command in another process. Hidden and non-blocking, the runite must go on at once
 * while the command works on its own; hidden and blocking, the runite waits for it.
 * The command is a small php job written in .proof/: it sleeps, then writes a file.
 * Souls (Specter::soul) are memory one process writes and another reads.
 * Runes: Aether, Whisper, Weaver, Chanter, Forger, Cipher, Keeper, Specter.
 *
 *   php cast test
 */
require_once __DIR__ . '/../../vendor/autoload.php';

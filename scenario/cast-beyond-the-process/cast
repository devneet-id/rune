// a job that sleeps $seconds, then writes $name.done in .proof/jobs/
function beyond_job( String $name, Int $seconds ) {
  $job = trial_proof("jobs/$name.php");
  if (!is_dir(dirname($job))) {
    mkdir(dirname($job), 0777, true);
  }
  $done = var_export(trial_proof("jobs/$name.done"), true);
  file_put_contents($job, "<?php\nsleep($seconds);\nfile_put_contents($done, 'done');\n");
  $quote = fn($path) => PHP_OS_FAMILY === 'Windows' ? '"' . $path . '"' : escapeshellarg($path);
  return $quote(PHP_BINARY) . ' ' . $quote($job);
}

// waits up to $seconds for a file
function beyond_wait( String $file, Int $seconds ) {
  $deadline = microtime(true) + $seconds;
  while (!is_file($file) && microtime(true) < $deadline) {
    usleep(100000);
  }
  return is_file($file);
}

// reads a soul in this process: run by the trial in another process
Chanter::cast('soul-read --name', function() {
  print('SOUL=' . json_encode(Specter::soul((string) Chanter::spell('name'))) . "\n");
}, 'Print a soul. --name=<name>');

Chanter::cast('test', function() {
  trial_proof_clean('jobs');

  trial_section('Hidden, non-blocking (devneet-id/rune#18)');
  $start = microtime(true);
  trial_capture(function() { Specter::cast(beyond_job('detached', 2), ['visible'=> false, 'blocking'=> false, 'exit'=> true]); });
  $took = microtime(true) - $start;
  trial('the runite goes on at once (the 2 s job runs on its own)', $took < 1);
  trial('the job still finishes in its own process', beyond_wait(trial_proof('jobs/detached.done'), 6));

  trial_section('Hidden, blocking');
  $start = microtime(true);
  trial_capture(function() { Specter::cast(beyond_job('waited', 1), ['visible'=> false, 'blocking'=> true, 'exit'=> true]); });
  $took = microtime(true) - $start;
  trial('the runite waits for the job', $took >= 1 && is_file(trial_proof('jobs/waited.done')));

  trial_section('Specter remembers its casts');
  $casts = Keeper::item('cast');
  trial('every cast is kept in .echoes (cast.json)', is_object($casts) && count((array) $casts) >= 2);

  trial_section('Souls: memory shared across processes');
  $before = Keeper::item('soul');
  Specter::soul('mood', 'calm');
  trial('a soul is read back in this process', Specter::soul('mood') === 'calm');
  trial('it is kept in .echoes (soul.json)', (Keeper::item('soul')->mood ?? null) === 'calm');
  $out = (string) shell_exec(escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg(__FILE__) . ' soul-read --name=mood 2>&1');
  trial('another process of this runite reads the same soul', str_contains($out, 'SOUL="calm"'));
  Specter::soul('mood', 'stormy');
  $out = (string) shell_exec(escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg(__FILE__) . ' soul-read --name=mood 2>&1');
  trial('a new value reaches it too', str_contains($out, 'SOUL="stormy"'));
  trial('a soul never set is false', Specter::soul('never-set') === false);
  Keeper::item('soul', $before ?: []);

  trial_report();
}, 'Trial of this scenario.');



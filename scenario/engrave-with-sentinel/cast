#!/usr/bin/env php
<?php
/*
 * SCENARIO — ENGRAVE WITH SENTINEL
 * Sentinel writes runes into a runite and takes them out (--runite-insert / --runite-remove).
 * It edits the runite that casts it, so the trial works on a probe runite in .proof/:
 * a copy of the blank runite of Awakening, with Forger (which Sentinel needs).
 * Runes: Aether, Whisper, Weaver, Chanter, Forger.
 *
 *   php cast test
 */
require_once __DIR__ . '/../../vendor/autoload.php';
require_once __DIR__ . '/../trial.php';

use Rune\Aether\Manifest as Aether;
use Rune\Whisper\Manifest as Whisper;
use Rune\Weaver\Manifest as Weaver;
use Rune\Chanter\Manifest as Chanter;
use Rune\Forger\Manifest as Forger;
#sentinel-manifest
Aether::ether()::essence()::entity();
Whisper::ether()::essence()::entity();
Weaver::ether()::essence()::entity();
Chanter::ether()::essence()::entity();
Forger::ether()::essence()::entity();
#sentinel-awaken

Aether::begin();
Chanter::begin();


// a fresh probe runite: the blank runite of Awakening, with Forger awakened and the autoload of rune-dev
function engrave_probe() {
  $blank = (string) file_get_contents(\Rune\Ethereal::$runite . 'awakening/blank.txt');
  $runite = str_replace("require_once __DIR__ . '/vendor/autoload.php';", 'require_once ' . var_export(dirname(__DIR__, 2) . '/vendor/autoload.php', true) . ';', $blank);
  $runite = str_replace("#sentinel-manifest", "use Rune\\Forger\\Manifest as Forger;\n#sentinel-manifest", $runite);
  $runite = str_replace("#sentinel-awaken", "Forger::ether()::essence()::entity();\n#sentinel-awaken", $runite);
  $probe = trial_proof('probe/cast');
  if (!is_dir(dirname($probe))) {
    mkdir(dirname($probe), 0777, true);
  }
  file_put_contents($probe, $runite);
  return $probe;
}

// an older runite: the same probe without the #sentinel-flow-* markers
function engrave_probe_old() {
  $probe = engrave_probe();
  file_put_contents($probe, preg_replace('/^#sentinel-flow-(begin|end)\R/m', '', (string) file_get_contents($probe)));
  return $probe;
}

// the line number of the first line that starts with $text (0 when missing)
function engrave_line( String $source, String $text ) {
  foreach (preg_split('/\R/', $source) as $index => $line) {
    if (str_starts_with(trim($line), $text)) {
      return $index + 1;
    }
  }
  return 0;
}

// casts the probe in its own process and returns its plain output
function engrave_cast( String $probe, String $spells ) {
  return trial_plain((string) shell_exec(escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg($probe) . ' sentinel ' . $spells . ' 2>&1'));
}

Chanter::cast('test', function() {
  trial_proof_clean('probe');
  $probe = engrave_probe();
  $source = fn() => (string) file_get_contents($probe);

  trial_section('Insert');
  $said = engrave_cast($probe, '--runite-insert=Cipher');
  trial('Sentinel says it inserted Cipher', str_contains($said, "Inserted 'Cipher'"));
  trial('the runite now uses and awakens Cipher', str_contains($source(), 'use Rune\Cipher\Manifest as Cipher;') && str_contains($source(), 'Cipher::ether()::essence()::entity();'));
  trial('the probe still runs', str_contains(trial_plain((string) shell_exec(escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg($probe) . ' 2>&1')), 'Version='));
  $before = $source();
  $said = engrave_cast($probe, '--runite-insert=Nothing');
  trial('an unknown rune is refused on insert', str_contains($said, 'Failed') && $source() === $before);

  trial_section('Remove (devneet-id/rune#21)');
  $before = $source();
  $said = engrave_cast($probe, '--runite-remove=Nothing');
  trial('an unknown rune is refused on remove, the runite unchanged', !str_contains($said, "Removed 'Nothing'") && $source() === $before);
  $said = engrave_cast($probe, '--runite-remove=Crafter');
  trial('a rune that is not in the runite is refused on remove', !str_contains($said, "Removed 'Crafter'") && $source() === $before);
  $said = engrave_cast($probe, '--runite-remove=Cipher');
  trial('Sentinel says it removed Cipher', str_contains($said, "Removed 'Cipher'"));
  trial('the runite no longer uses or awakens Cipher', !str_contains($source(), 'Rune\Cipher') && !str_contains($source(), 'Cipher::'));

  trial_section('A rune with a flow: Keeper (devneet-id/rune#20)');
  $probe = engrave_probe();
  $said = engrave_cast($probe, '--runite-insert=Keeper');
  $code = $source();
  $at = fn($text) => engrave_line($code, $text);
  trial('the runite has the flow markers', $at('#sentinel-flow-begin') > 0 && $at('#sentinel-flow-end') > 0);
  trial('Keeper::begin() is written after Chanter::begin(), above #sentinel-flow-begin', $at('Keeper::begin();') > $at('Chanter::begin();') && $at('Keeper::begin();') < $at('#sentinel-flow-begin'));
  trial('Keeper::end() is written after Chanter::end(), before Aether::end()', $at('Keeper::end();') > $at('Chanter::end();') && $at('Keeper::end();') < $at('Aether::end();'));
  trial('Aether and Chanter are not written twice', substr_count($code, 'Aether::begin();') === 1 && substr_count($code, 'Chanter::end();') === 1);
  trial_safe(function() use ($probe) { shell_exec(escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg($probe) . ' 2>&1'); });
  trial('the probe now keeps its memory (Keeper writes .echoes)', is_file(dirname($probe) . '/.echoes/cast/arcane.txt'));
  engrave_cast($probe, '--runite-remove=Keeper');
  trial('removing Keeper takes begin() and end() out too', !str_contains($source(), 'Keeper::'));

  trial_section('A rune without a flow');
  engrave_cast($probe, '--runite-insert=Cipher');
  trial('Cipher gets no begin() / end()', !str_contains($source(), 'Cipher::begin') && !str_contains($source(), 'Cipher::end'));

  trial_section('An older runite without the markers');
  $probe = engrave_probe_old();
  $said = engrave_cast($probe, '--runite-insert=Keeper');
  trial('Sentinel warns that begin() / end() must be added by hand', str_contains($said, '#sentinel-flow-begin') && str_contains($said, 'Keeper::begin();'));
  trial('nothing is guessed: no Keeper::begin() written', !str_contains($source(), 'Keeper::begin();'));

  trial_report();
}, 'Trial of this scenario.');


#sentinel-codex
Chanter::end();
Aether::end();
